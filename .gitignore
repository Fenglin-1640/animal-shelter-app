# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# prisma (local sqlite dev database - see prisma/README.md)
/prisma/dev.db
/prisma/dev.db-journal

# scripts/qa-test-runner generated output - regenerable by re-running the
# runner against test-data/ASAMS_60_Animal_Test_Data.xlsx (which IS
# committed, as the actual input fixture). Photos are placeholder JPEGs
# re-derived from the workbook on every run; results/ is the run log +
# report from whoever last ran it locally, not a source of truth.
/test-data/photos/
/test-data/results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
