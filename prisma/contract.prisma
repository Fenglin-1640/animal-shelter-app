// Prisma 8 "contract" (this toolchain's replacement for the classic
// schema.prisma + PrismaClient generator - see prisma/README.md).
//
// Mirrors the User shape already used across lib/auth/ and
// lib/user-administration/ (RegisteredAccount + DemoAccount + the
// ProfileOverride/DirectoryOverride/LockoutState overlays they were
// layered on top of), consolidated into one real table now that there is
// a database to hold it in.

model User {
  id                  String    @id
  email               String    @unique
  password            String
  role                String
  status              String
  title               String
  firstName           String
  lastName            String
  phone               String
  signUpAt            DateTime
  lastLoginAt         DateTime?
  roleUpdatedBy       String?
  roleUpdatedAt       DateTime?
  statusUpdatedBy     String?
  statusUpdatedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedAt            DateTime?
}

// Mirrors lib/animals/types.ts's Animal interface - the core entity
// almost every other module (Medical, Behaviour, Statutory Hold,
// Applications, ...) references by animalId, which is why this is the
// second (and, for this pilot round, last) slice moved off localStorage.
// dateOfBirth/estimatedAge stay plain strings (not DateTime) - they're
// date-only/free-text values from a date picker or free text field, not
// timestamps, and a DateTime column would risk a timezone-shift bug on
// round-trip. temperaments is JSON-encoded (string[]) - see
// lib/animals/serialize.ts. linkedPerson is flattened into two nullable
// columns instead of a JSON object, for the same "keep it simple, one
// small object" reasoning as User's overlay fields.
model Animal {
  animalId           String   @id
  shelterId           String   @unique
  name                String
  species             String
  breed               String
  breedDescription    String
  sex                 String
  dateOfBirth         String?
  estimatedAge        String?
  coatColour          String
  coatMarkings        String
  microchipNumber     String?
  generalDescription  String
  temperaments        String
  adoptionFee         Float?
  currentStatus       String
  listingStatus       String
  statusUpdatedAt     DateTime
  enteredAt           DateTime
  lastModifiedAt      DateTime
  intakeSource        String
  linkedPersonRole    String?
  linkedPersonName    String?
}

// Mirrors lib/medical/types.ts (FR-MED-01/02/03, FR-REL-01) - one model
// per event kind, same shape as the original localStorage arrays.
// createdAt/issuedAt/completedAt are system-generated timestamps (kept
// as DateTime, like Animal's enteredAt/lastModifiedAt); the
// user-entered/free-editable dates below them (assessmentDate,
// administrationDate, nextBoosterDueDate, scheduledDate, checkDate,
// TreatmentEvent.date) stay plain strings for the same reason Animal's
// dateOfBirth does - see lib/medical/serialize.ts.
model HealthAssessment {
  id                      String   @id
  animalId                String
  examinationObservations String
  sampleTestResults       String
  diagnosedConditions     String
  bodyCondition           String
  // Int (0/1), not Boolean - this SQL PSL provider doesn't support the
  // Boolean field type (CONTRACT.SOURCE_LOAD_FAILED /
  // PSL_UNSUPPORTED_FIELD_TYPE) - see lib/medical/serialize.ts.
  urgentTreatmentRequired Int
  urgentTreatmentNotes    String
  treatmentPathway        String?
  assessmentDate          String
  veterinarianEmail       String
  veterinarianName        String
  createdAt               DateTime
}

model TreatmentEvent {
  id                       String   @id
  animalId                 String
  linkedHealthAssessmentId String
  medication                String
  dose                      String
  date                      String
  outcome                   String
  furtherTreatmentRequired  Int
  veterinarianEmail         String
  veterinarianName          String
  createdAt                 DateTime
}

model VaccinationRecord {
  id                 String   @id
  animalId           String
  vaccineType        String
  administrationDate String
  doseOrChipId       String
  nextBoosterDueDate String
  veterinarianEmail  String
  veterinarianName   String
  createdAt          DateTime
}

model DesexingSchedule {
  id                String    @id
  animalId          String
  scheduledDate     String
  status            String
  completedAt       DateTime?
  completedByEmail  String?
  completedByName   String?
  veterinarianEmail String
  veterinarianName  String
  createdAt         DateTime
}

model MedicalClearance {
  id            String   @id
  animalId      String
  issuedByEmail String
  issuedByName  String
  issuedAt      DateTime
}

model PreReleaseCheck {
  id                 String   @id
  animalId           String
  checkDate          String
  fitnessResult      String
  healthFindings     String
  medicationGuidance String
  careInstructions   String
  veterinarianEmail  String
  veterinarianName   String
  createdAt          DateTime
}
