// Prisma 8 "contract" (this toolchain's replacement for the classic
// schema.prisma + PrismaClient generator - see prisma/README.md).
//
// Mirrors the User shape already used across lib/auth/ and
// lib/user-administration/ (RegisteredAccount + DemoAccount + the
// ProfileOverride/DirectoryOverride/LockoutState overlays they were
// layered on top of), consolidated into one real table now that there is
// a database to hold it in.

model User {
  id                  String    @id
  email               String    @unique
  password            String
  role                String
  status              String
  title               String
  firstName           String
  lastName            String
  phone               String
  signUpAt            TimestamptzString(6)
  lastLoginAt         TimestamptzString(6)?
  roleUpdatedBy       String?
  roleUpdatedAt       TimestamptzString(6)?
  statusUpdatedBy     String?
  statusUpdatedAt     TimestamptzString(6)?
  failedLoginAttempts Int       @default(0)
  lockedAt            TimestamptzString(6)?
}

// Mirrors lib/animals/types.ts's Animal interface - the core entity
// almost every other module (Medical, Behaviour, Statutory Hold,
// Applications, ...) references by animalId, which is why this is the
// second (and, for this pilot round, last) slice moved off localStorage.
// dateOfBirth/estimatedAge stay plain strings (not DateTime) - they're
// date-only/free-text values from a date picker or free text field, not
// timestamps, and a DateTime column would risk a timezone-shift bug on
// round-trip. temperaments is JSON-encoded (string[]) - see
// lib/animals/serialize.ts. linkedPerson is flattened into two nullable
// columns instead of a JSON object, for the same "keep it simple, one
// small object" reasoning as User's overlay fields.
model Animal {
  animalId           String   @id
  shelterId           String   @unique
  name                String
  species             String
  breed               String
  breedDescription    String
  sex                 String
  dateOfBirth         String?
  estimatedAge        String?
  coatColour          String
  coatMarkings        String
  microchipNumber     String?
  generalDescription  String
  temperaments        String
  adoptionFee         Float?
  currentStatus       String
  listingStatus       String
  statusUpdatedAt     TimestamptzString(6)
  enteredAt           TimestamptzString(6)
  lastModifiedAt      TimestamptzString(6)
  intakeSource        String
  linkedPersonRole    String?
  linkedPersonName    String?
}

// Mirrors lib/medical/types.ts (FR-MED-01/02/03, FR-REL-01) - one model
// per event kind, same shape as the original localStorage arrays.
// createdAt/issuedAt/completedAt are system-generated timestamps (kept
// as DateTime, like Animal's enteredAt/lastModifiedAt); the
// user-entered/free-editable dates below them (assessmentDate,
// administrationDate, nextBoosterDueDate, scheduledDate, checkDate,
// TreatmentEvent.date) stay plain strings for the same reason Animal's
// dateOfBirth does - see lib/medical/serialize.ts.
model HealthAssessment {
  id                      String   @id
  animalId                String
  examinationObservations String
  sampleTestResults       String
  diagnosedConditions     String
  bodyCondition           String
  // Int (0/1), not Boolean - this SQL PSL provider doesn't support the
  // Boolean field type (CONTRACT.SOURCE_LOAD_FAILED /
  // PSL_UNSUPPORTED_FIELD_TYPE) - see lib/medical/serialize.ts.
  urgentTreatmentRequired Int
  urgentTreatmentNotes    String
  treatmentPathway        String?
  // Flags that this assessment found something needing a follow-up
  // recheck before Medical Clearance (distinct from
  // urgentTreatmentRequired - a recheck isn't an Under Treatment
  // episode, just a "check again before clearing" note). Int (0/1),
  // same reasoning as urgentTreatmentRequired, but nullable (existing
  // rows predate this column - added to an existing table, unlike
  // urgentTreatmentRequired which was there from this table's first
  // migration). Read by getMedicalClearanceBlockers()
  // (lib/medical/store.ts), which looks at only the MOST RECENT
  // HealthAssessment for this animal - a later assessment recorded with
  // this false resolves an earlier one's flag, the same "newest event
  // wins" pattern isFitForRelease() already uses for PreReleaseCheck.
  healthRecheckRequired Int?
  assessmentDate          String
  veterinarianEmail       String
  veterinarianName        String
  createdAt               TimestamptzString(6)
}

model TreatmentEvent {
  id                       String   @id
  animalId                 String
  linkedHealthAssessmentId String
  medication                String
  dose                      String
  date                      String
  outcome                   String
  furtherTreatmentRequired  Int
  veterinarianEmail         String
  veterinarianName          String
  createdAt                 TimestamptzString(6)
}

model VaccinationRecord {
  id                 String   @id
  animalId           String
  vaccineType        String
  administrationDate String
  doseOrChipId       String
  nextBoosterDueDate String
  veterinarianEmail  String
  veterinarianName   String
  createdAt          TimestamptzString(6)
  // Why the vaccine was given although a current antibody check showed
  // protection; the note is required when the reason is "Other".
  antibodyOverrideReason String?
  antibodyOverrideNote   String?
}

model DesexingSchedule {
  id                String    @id
  animalId          String
  scheduledDate     String
  status            String
  completedAt       TimestamptzString(6)?
  completedByEmail  String?
  completedByName   String?
  veterinarianEmail String
  veterinarianName  String
  createdAt         TimestamptzString(6)
}

model MedicalClearance {
  id            String   @id
  animalId      String
  issuedByEmail String
  issuedByName  String
  issuedAt      TimestamptzString(6)
}

model PreReleaseCheck {
  id                 String   @id
  animalId           String
  checkDate          String
  fitnessResult      String
  healthFindings     String
  medicationGuidance String
  careInstructions   String
  veterinarianEmail  String
  veterinarianName   String
  createdAt          TimestamptzString(6)
}

// Mirrors lib/behaviour/types.ts (FR-BEH-01/02). followUpRequired is
// Int (0/1), not Boolean - see the note on HealthAssessment above.
model TemperamentAssessment {
  id                          String   @id
  animalId                    String
  handlingResponse            String
  reactionToStrangers         String
  foodBehaviour                String
  interactionWithOtherAnimals  String
  socialisationScore            Int
  observations                   String
  recommendations                 String
  assessmentDate                   String
  assessorEmail                     String
  assessorName                      String
  followUpRequired                   Int
  reassessmentDate                    String?
  outcome                             String
  createdAt                            TimestamptzString(6)
  programReassessmentOf                String?
}

model BehaviourProgram {
  id                     String    @id
  animalId               String
  triggeringAssessmentId String
  status                 String
  createdAt              TimestamptzString(6)
  resolvedAt             TimestamptzString(6)?
}

// Mirrors lib/statutory-hold/types.ts (FR-MC-02). ownerContact is
// flattened into 3 columns, same "one small object" reasoning as
// Animal's linkedPerson. Every date field here is system-generated
// (computed from intake date + configured holding period, or a
// timestamp of when an action happened), so all of them are DateTime,
// unlike Medical/Behaviour's mix of DateTime and user-entered String.
model StatutoryHold {
  id                         String    @id
  animalId                   String
  ownerContactName           String
  ownerContactPhone          String
  ownerContactAddress        String
  holdStartAt                TimestamptzString(6)
  holdEndAt                  TimestamptzString(6)
  holdingPeriodDays          Int
  status                     String
  createdAt                  TimestamptzString(6)
  reclaimedAt                TimestamptzString(6)?
  reclaimedByEmail           String?
  reclaimedByName            String?
  custodyTransferCompletedAt TimestamptzString(6)?
  custodyTransferByEmail     String?
  custodyTransferByName      String?
  expiredAt                  TimestamptzString(6)?
}

// Mirrors lib/applications/types.ts (FR-APP-01). documents (array of
// small objects) and profileSnapshot (a whole nested AdopterProfile,
// 16 fields, always read/written as one unit and never queried
// field-by-field) are both JSON-encoded into single String columns
// rather than flattened - unlike Animal/StatutoryHold's small
// 2-3-field objects, flattening either of these would mean a lot of
// schema surface for data nothing ever queries by field. See
// lib/applications/serialize.ts.
// adoptionFee is the Animal's fee as it stood when the Adopter
// submitted - the amount AdoptionPayment charges, so a later fee edit
// on the Animal Profile can't change what an in-flight applicant pays.
// Nullable: drafts and applications submitted before this column
// existed have none (payment falls back to the Animal's current fee).
model AdoptionApplication {
  applicationId       String    @id
  adopterEmail        String
  adopterName         String
  animalId            String
  animalName          String
  animalSpecies       String
  animalBreed         String
  adoptionFee         Float?
  motivationStatement String
  documents           String
  profileSnapshot     String?
  applicationStatus   String
  submissionDate      TimestamptzString(6)?
  decisionDate        TimestamptzString(6)?
  decisionByEmail     String?
  decisionByName      String?
  rejectionReason     String?
  createdAt           TimestamptzString(6)
  updatedAt           TimestamptzString(6)
  // Shelter Staff asking the Adopter for more documents or information
  // during review: the message, when and by whom, and when the Adopter
  // last uploaded a document in response.
  infoRequestMessage  String?
  infoRequestedAt     TimestamptzString(6)?
  infoRequestedByName String?
  infoRespondedAt     TimestamptzString(6)?
}

// Mirrors lib/checks/types.ts (FR-CHK-01/02). conductedDate stays
// String - the caller already converts it to an ISO string before this
// module ever sees it, same "not worth a second DateTime round-trip"
// reasoning as PreReleaseCheck.checkDate.
model SuitabilityCheck {
  checkId          String  @id
  applicationId    String
  checkType        String
  outcome          String
  checkNotes       String
  conductedDate    String?
  completedByEmail String?
  completedByName  String?
}

// Mirrors lib/meet-and-greets/types.ts (FR-MG-01). slotOptions (array of
// small {id, dateTime, location} objects, always read/written as a
// whole) is JSON-encoded, same reasoning as AdoptionApplication.documents.
// scheduledDate stays a plain String, not DateTime - it's copied
// verbatim from whichever slotOptions entry the Adopter picks, and those
// are themselves user-entered datetime-local strings, same reasoning as
// Medical/Behaviour's user-entered date fields. attendanceConfirmed is
// Int (0/1), not Boolean - see the note on HealthAssessment above.
// Mirrors lib/agreements/types.ts (FR-AGR-01). No nested objects/arrays
// here (unlike MeetAndGreet.slotOptions) so every field is a plain
// column. isSigned is Int (0/1), same reasoning as MeetAndGreet's
// attendanceConfirmed. generatedAt/signedDate are both system-generated
// timestamps (set to `now` when the action happens), so both are
// DateTime, unlike Medical/Behaviour's user-entered date strings.
model AdoptionAgreement {
  agreementId       String    @id
  applicationId     String
  animalId          String
  animalName        String
  animalSpecies     String
  adopterEmail      String
  adopterName       String
  agreementVersion  String
  templateVersion   String
  adoptionConditions String
  returnPolicyPeriod String
  generatedAt       TimestamptzString(6)
  generatedByEmail  String
  generatedByName   String
  isSigned          Int
  signedDate        TimestamptzString(6)?
  createdAt         TimestamptzString(6)
  updatedAt         TimestamptzString(6)
}

// Mirrors lib/payments/types.ts (FR-PAY-01). Same "no nested
// objects/arrays, every field a plain column" shape as
// AdoptionAgreement above. paymentDate/verifiedDate are both
// system-generated timestamps, so both are DateTime.
model AdoptionPayment {
  paymentId        String    @id
  agreementId      String
  applicationId    String
  animalId         String
  animalName       String
  animalSpecies    String
  adopterEmail     String
  adopterName      String
  amount           Float
  paymentMethod    String
  paymentDate      TimestamptzString(6)
  paymentStatus    String
  receiptNumber    String?
  verifiedByEmail  String?
  verifiedByName   String?
  verifiedDate     TimestamptzString(6)?
  failureReason    String?
  createdAt        TimestamptzString(6)
  updatedAt        TimestamptzString(6)
}

model MeetAndGreet {
  meetAndGreetId      String    @id
  applicationId       String
  animalId            String
  animalName          String
  animalSpecies       String
  adopterEmail        String
  adopterName         String
  slotOptions         String
  selectedSlotId      String?
  scheduledDate       String?
  location            String?
  participants        String
  staffNotes          String
  status              String
  attendanceConfirmed Int
  outcome             String?
  outcomeReason       String?
  createdByEmail      String
  createdByName       String
  createdAt           TimestamptzString(6)
  updatedAt           TimestamptzString(6)
}

// Mirrors lib/follow-up-visits/types.ts (FR-REL-02). No nested
// objects/arrays here, same "every field a plain column" shape as
// AdoptionAgreement/AdoptionPayment. releaseDate/targetDate stay plain
// Strings - both are user-entered values from a date-picker input (see
// components/medical/pre-release-check-screen.tsx's ReleaseForm), same
// reasoning as Medical/Behaviour's user-entered date fields.
// careInstructionsProvided is Int (0/1), same reasoning as
// AdoptionAgreement's isSigned. completedAt is a system-generated
// timestamp (set to `now` when the visit is completed), so it's
// DateTime, unlike releaseDate/targetDate above it.
model FollowUpVisit {
  followUpVisitId          String    @id
  animalId                 String
  animalName               String
  applicationId             String
  adopterEmail              String
  adopterName               String
  careInstructionsProvided  Int
  releaseDate               String
  receivingAdopter          String
  releasedByEmail           String
  releasedByName            String
  targetDate                String
  followUpType              String
  assignedStaffEmail        String
  assignedStaffName         String
  status                    String
  outcome                   String?
  outcomeNotes              String
  completedByEmail          String?
  completedByName           String?
  completedAt               TimestamptzString(6)?
  createdAt                 TimestamptzString(6)
}

// Mirrors lib/council-transfers/types.ts (FR-INT-01). attachments
// (array of small {id, documentType, fileName, fileSizeKB, uploadedAt}
// objects, always read/written as a whole) is JSON-encoded, same
// reasoning as AdoptionApplication.documents. submissionDate is a
// system-generated timestamp (set to `now` when submitted), so it's
// DateTime.
model CouncilTransferSubmission {
  id                 String    @id
  submittedByEmail   String
  submittedByName    String
  source             String
  arrivalCircumstance String
  foundLocation       String
  animalDescription    String
  attachments           String
  status                 String
  submissionDate          TimestamptzString(6)?
  createdAt                TimestamptzString(6)
  updatedAt                 TimestamptzString(6)
}

// Mirrors lib/intake-records/types.ts (FR-INT-02). photos (array of
// small {id, fileName, fileSizeKB, uploadedAt} objects) is JSON-encoded,
// same reasoning as CouncilTransferSubmission.attachments.
// registeredOwnerContact is flattened into 3 columns, same "one small
// object" reasoning as Animal.linkedPerson. arrivalDateTime stays a
// plain String, not DateTime - it's a user-entered value from a
// datetime-local input, same reasoning as MeetAndGreet.scheduledDate.
// finalisedAt is a system-generated timestamp (set to `now` when
// Finalise Intake runs), so it's DateTime.
// breed/adoptionFee/temperaments/generalDescription are captured at
// intake and copied onto the Animal by Finalise Intake (temperaments is
// JSON-encoded, same as Animal.temperaments). All four are nullable so
// intake records created before these columns existed stay valid.
model IntakeRecord {
  intakeId            String    @id
  animalId             String
  createdByEmail        String
  createdByName          String
  animalName               String
  arrivalCircumstance       String
  arrivalDateTime            String
  intakeSource                String
  surrenderingPartyName        String
  councilTransferSubmissionId   String?
  species                         String
  estimatedAge                    String
  dateOfBirth                      String
  sex                                String
  coatColour                         String
  coatMarkings                        String
  photos                               String
  breed                                String?
  adoptionFee                          Float?
  temperaments                         String?
  generalDescription                   String?
  createdAt                            TimestamptzString(6)
  updatedAt                             TimestamptzString(6)
  finalisedAt                           TimestamptzString(6)?
  registeredOwnerContactName             String?
  registeredOwnerContactPhone             String?
  registeredOwnerContactAddress            String?
}

// Mirrors lib/photos/types.ts (FR-AN-02). dateTaken stays a plain
// String, not DateTime - it's a user-entered value from a date-picker
// input, same reasoning as Medical/Behaviour's user-entered date
// fields. useOnAdoptionListing is Int (0/1), same reasoning as
// AdoptionAgreement's isSigned. uploadedAt is a system-generated
// timestamp, so it's DateTime. imageData is a base64 data URL of the
// actual uploaded image (downscaled client-side before upload) - added
// so photos render for real instead of a placeholder icon; nullable
// since rows seeded before this field existed have none. No real
// filesystem storage is used (this app deploys to Vercel, which has no
// writable/persistent filesystem for uploads), so the bytes live in
// this column instead - same reasoning that ruled out disk storage
// anywhere else in this prototype.
model Photo {
  id                  String   @id
  animalId            String
  fileName            String
  fileSizeKB          Int
  dateTaken           String
  takenByEmail        String
  takenByName         String
  useOnAdoptionListing Int
  altText              String
  uploadedAt            TimestamptzString(6)
  imageData             String?
}

// Mirrors lib/adopter-profile/types.ts (FR-ADP-01). Keyed by the
// account's email (lowercased) rather than a generated id - there is
// exactly one profile per Adopter, no separate identity of its own.
// preferredSpecies (a small array of enum strings) is JSON-encoded,
// same reasoning as AdoptionApplication.documents. landlordPermission/
// hasExistingPets/refereeConsent are Int (0/1), same reasoning as
// AdoptionAgreement's isSigned. refereeConsentAt is a system-generated
// timestamp (set to `now` the moment consent is first given), so it's
// DateTime, unlike every other field here which is free-editable text
// from the Adopter's own form.
model AdopterProfile {
  email               String    @id
  residentialAddress  String
  householdType       String
  homeOwnership       String
  landlordPermission  Int
  adultsInHousehold   String
  childrenInHousehold String
  hasExistingPets     Int
  existingPetDetails  String
  environmentDetails  String
  hoursAlone          String
  preferredSpecies    String
  refereeName         String
  refereeRelationship String
  refereePhone        String
  refereeEmail        String
  refereeConsent      Int
  refereeConsentAt    TimestamptzString(6)?
}

// Mirrors lib/audit/types.ts (FR-AUD-01/BR-013). Every field a plain
// column, same shape as AdoptionAgreement/AdoptionPayment. Immutability
// ("应用界面不提供修改或删除 AuditLog 的功能") is enforced the same way it always
// was - lib/audit/store.ts exposes only a write and two read functions,
// never an update or delete - not by anything the database layer itself
// restricts. timestamp is a system-generated timestamp (set to `now`
// the moment the entry is written), so it's DateTime.
model AuditLogEntry {
  auditId    String   @id
  userId     String
  userName   String
  timestamp  TimestamptzString(6)
  action     String
  entityType String
  entityId   String
  oldValue   String
  newValue   String
  result     String
}

// Mirrors lib/system-administration/types.ts (FR-SA-01). Every field a
// plain column - speciesId is a small enum-like string, not worth its
// own JSON encoding or relation. isRetired/systemLocked are Int (0/1),
// same reasoning as AdoptionAgreement's isSigned. The ~85 PRD-seeded
// options (lib/system-administration/seed-options.ts) now live in
// prisma/seed.ts alongside the other seed data, not as a runtime
// localStorage-empty fallback - see the AdopterProfile precedent.
model DropdownOption {
  id           String   @id
  category     String
  value        String
  description  String
  speciesId    String?
  isRetired    Int
  systemLocked Int
  createdAt    TimestamptzString(6)
  updatedAt    TimestamptzString(6)
  // Vaccine Type options only (optional): JSON lists of the Species
  // option ids the vaccine applies to and the antigens it covers.
  applicableSpecies String?
  coversAntigens    String?
}

// Mirrors lib/system-administration/settings-types.ts (FR-SA-02). A
// singleton row (id is always the literal "system-settings", matching
// the entityId every writeAuditLog call for this domain already used)
// - there is exactly one rule-configuration record for the whole
// shelter, unlike DropdownOption's many-rows-per-category shape.
// allowedAttachmentTypes (a small array of strings) is JSON-encoded,
// same reasoning as AdoptionApplication.documents.
model SystemSettings {
  id                       String @id
  holdingPeriodDays        Int
  reminderLeadDays         Int
  allowedAttachmentTypes   String
  maxAttachmentSizeMB      Int
  agreementTemplateVersion String
}

// Mirrors lib/microchip/types.ts (FR-MC-01). Immutable - "不可删除" means
// performScan only ever appends, same shape as AuditLogEntry (no
// PATCH/DELETE route, no update/delete export). ownerContact is
// flattened into 3 columns, same reasoning as Animal.linkedPerson.
// performedAt is a system-generated timestamp, so it's DateTime.
model MicrochipLookup {
  id                  String   @id
  animalId            String
  microchipNumber     String
  result              String
  ownerContactName    String?
  ownerContactPhone   String?
  ownerContactAddress String?
  performedByEmail    String
  performedByName     String
  performedAt         TimestamptzString(6)
}

// Mirrors lib/adoption-fitness/types.ts (FR-INT-04). markedAt is a
// system-generated timestamp, so it's DateTime.
model AssessmentTask {
  id            String    @id
  animalId      String
  taskType      String
  status        String
  markedByEmail String?
  markedByName  String?
  markedAt      TimestamptzString(6)?
}

// Keyed by animalId - there is exactly one joint Fitness Review per
// Animal, no separate identity of its own, same "singleton keyed by the
// owning record" shape as AdopterProfile (keyed by email). Every field
// maps directly onto the domain type - no flattening or JSON-encoding
// needed. staffConfirmedAt/vetConfirmedAt are system-generated
// timestamps, so both are DateTime.
model FitnessReview {
  animalId              String    @id
  staffConfirmedByEmail String?
  staffConfirmedByName  String?
  staffConfirmedAt      TimestamptzString(6)?
  vetConfirmedByEmail   String?
  vetConfirmedByName    String?
  vetConfirmedAt        TimestamptzString(6)?
  // How the Vet half was confirmed - a Medical Clearance issued by a
  // Veterinarian confirms it automatically ("Confirmed together with
  // Medical Clearance").
  vetConfirmationNote   String?
}

// A Scan Microchip that finds no chip assigns a new, unique microchip
// number (15 digits, prefix 036) and gives the Veterinarian this implant
// task; completing it sets the animal's microchip number and completes
// the Microchip Check fitness task. status: Pending | Completed.
// Uploaded files kept in the database (adoption application documents).
// The content is stored in chunks of at most 2 MB (StoredFileChunk) so
// neither an upload nor a download exceeds the hosting body-size limit;
// completedAt is set once every chunk has arrived. List endpoints return
// these metadata rows only.
model StoredFile {
  id              String   @id
  ownerType       String
  ownerId         String
  fileName        String
  contentType     String
  sizeBytes       Int
  chunkCount      Int
  uploadedByEmail String
  uploadedByName  String
  uploadedAt      TimestamptzString(6)
  completedAt     TimestamptzString(6)?
}

// One base64-encoded chunk of a StoredFile; id is "<fileId>:<chunkIndex>".
model StoredFileChunk {
  id         String @id
  fileId     String
  chunkIndex Int
  data       String
}

// A Veterinarian vaccination check: what the animal is already covered
// for (antibody results, vaccinations, outside evidence) and a report.
// evidence, coverage and notApplicable are JSON-encoded lists; whatever
// is not covered becomes VaccinationTask rows.
model VaccinationCheck {
  id             String   @id
  animalId       String
  checkDate      String
  report         String
  outcome        String
  evidence       String
  coverage       String
  notApplicable  String
  checkedByEmail String
  checkedByName  String
  createdAt      TimestamptzString(6)
}

// A vaccination still to be given after a vaccination check: Pending,
// then Completed (by a VaccinationRecord) or Waived (with a reason).
model VaccinationTask {
  id                     String    @id
  animalId               String
  checkId                String
  vaccineType            String
  status                 String
  dueDate                String?
  waivedReason           String?
  createdByEmail         String
  createdByName          String
  createdAt              TimestamptzString(6)
  completedVaccinationId String?
  resolvedByEmail        String?
  resolvedByName         String?
  resolvedAt             TimestamptzString(6)?
}

// Antibody (titre) test results recorded by a Veterinarian.
model AntibodyCheck {
  id              String   @id
  animalId        String
  antigen         String
  result          String
  testDate        String
  expiryDate      String?
  notes           String
  recordedByEmail String
  recordedByName  String
  createdAt       TimestamptzString(6)
}

model MicrochipImplantTask {
  id               String    @id
  animalId         String
  assignedNumber   String    @unique
  status           String
  createdByEmail   String
  createdByName    String
  createdAt        TimestamptzString(6)
  completedByEmail String?
  completedByName  String?
  completedAt      TimestamptzString(6)?
}

// Per-account "mark as read" overrides for the Notifications screen
// (each NotificationItem already carries its own defaultRead - this only
// stores the accounts that have flipped it). id is `${email}:${notificationId}`
// so a repeat toggle is a plain upsert, same shape as DropdownOption's
// synthetic ids.
model NotificationReadOverride {
  id             String @id
  email          String
  notificationId String
  isRead         Int
}
